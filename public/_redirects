# API passthrough
/api/* /api/:splat 200

# Canonical 301 redirects for legacy .html extensions
/index.html / 301
/research.html /research 301
/blog.html /blog 301
/team.html /team 301
/interns.html /team 301
/interns /team 301
/contact.html /contact 301
/portal.html /portal 301
/login.html /login 301
/article.html /article 301

# SPA fallback rewrite (all pages route through client-side router with no reload)
/* /index.html 200
